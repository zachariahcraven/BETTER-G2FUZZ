# The image takes afl/, g2fuzz/ and targets/ (see docker/Dockerfile.g2fuzz); keep the rest out of the
# build context.

# Never send secrets into the image
**/openai_key.txt
**/*.key
**/.env

# Campaign data, outputs and local builds
results/
experiments/
tests/
targets/bin/
**/build/
*_output/
initial_seeds/

# VCS / editor / OS noise
.git/
.DS_Store
.vscode/
.idea/
**/__pycache__/
**/*.pyc

# Host build artifacts (the image builds its own)
*.o
*.so

# Apptainer image and its source archive
*.sif
*.sif.*
g2fuzz-amd64.tar*
