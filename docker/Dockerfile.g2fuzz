#
# G2Fuzz image for development and experiments.
#
# Based on the upstream AFL++ Dockerfile (afl/Dockerfile) with these changes:
#   - builds `make source-only` instead of `make distrib` (no QEMU/Unicorn/Frida modes)
#   - drops rustup and afl-cov (not needed for G2Fuzz)
#   - keeps optional make steps non-fatal (no `sed` on GNUmakefile)
#   - installs the `openai` Python package G2Fuzz needs, plus pillow and numpy for generators
#   - prebuilds every fuzz target into /targets: <name>.afl, .cmp (CmpLog) and .asan (crash triage),
#     plus its stock seeds in /targets/seeds/<name>/ (built by targets/<folder>/build.sh)
#
# Layout in the image: /AFLplusplus is afl/ (AFL++), /AFLplusplus/g2fuzz is g2fuzz/ (afl-fuzz -k).
#
# Build from the repo root:
#   docker build -f docker/Dockerfile.g2fuzz -t g2fuzz:dev .
#
# The API key is never baked in; mount it at runtime (scripts/fuzz does this):
#   -v ~/.secrets/catchat.key:/eval/openai_key.txt:ro
#

FROM ubuntu:22.04
LABEL "about"="G2Fuzz (AFL++ 4.32c + LLM-synthesized input generators)"

ENV NO_CORESIGHT=1
ENV NO_NYX=1
ENV LLVM_VERSION=16
ENV GCC_VERSION=11

ARG DEBIAN_FRONTEND=noninteractive

ENV NO_ARCH_OPT=1
ENV IS_DOCKER=1

RUN apt-get update && apt-get full-upgrade -y && \
    apt-get install -y --no-install-recommends wget ca-certificates apt-utils gnupg && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/apt/keyrings && \
    echo "deb [signed-by=/etc/apt/keyrings/llvm-snapshot.gpg.key] http://apt.llvm.org/jammy/ llvm-toolchain-jammy-${LLVM_VERSION} main" > /etc/apt/sources.list.d/llvm.list && \
    wget -qO /etc/apt/keyrings/llvm-snapshot.gpg.key https://apt.llvm.org/llvm-snapshot.gpg.key

RUN apt-get update && \
    apt-get -y install --no-install-recommends \
    make cmake automake meson ninja-build bison flex \
    git xz-utils bzip2 wget nano vim less psmisc \
    python3 python3-dev python3-pip python-is-python3 \
    libtool libtool-bin libglib2.0-dev libpixman-1-dev \
    gnuplot-nox bc \
    gcc-${GCC_VERSION} g++-${GCC_VERSION} gcc-${GCC_VERSION}-plugin-dev gdb lcov \
    clang-${LLVM_VERSION} clang-tools-${LLVM_VERSION} libc++1-${LLVM_VERSION} \
    libc++-${LLVM_VERSION}-dev libc++abi1-${LLVM_VERSION} libc++abi-${LLVM_VERSION}-dev \
    libclang1-${LLVM_VERSION} libclang-${LLVM_VERSION}-dev \
    libclang-common-${LLVM_VERSION}-dev libclang-rt-${LLVM_VERSION}-dev libclang-cpp${LLVM_VERSION} \
    libclang-cpp${LLVM_VERSION}-dev liblld-${LLVM_VERSION} liblld-${LLVM_VERSION}-dev \
    libllvm${LLVM_VERSION} lld-${LLVM_VERSION} \
    llvm-${LLVM_VERSION} llvm-${LLVM_VERSION}-dev llvm-${LLVM_VERSION}-runtime llvm-${LLVM_VERSION}-tools \
    $([ "$(dpkg --print-architecture)" = "amd64" ] && echo gcc-${GCC_VERSION}-multilib gcc-multilib) && \
    rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-${GCC_VERSION} 0 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-${GCC_VERSION} 0 && \
    update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-${GCC_VERSION} 0 && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-${LLVM_VERSION} 0 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-${LLVM_VERSION} 0

# G2Fuzz's Python dependency (version pinned by the upstream README)
RUN pip install --no-cache-dir openai==1.63.2

# Libraries LLM-written generators commonly import. Preinstalled so generators don't fail on
# ModuleNotFoundError (G2Fuzz discards a generator if its runtime pip install fails) and so
# every campaign uses the same versions.
RUN pip install --no-cache-dir pillow==11.3.0 numpy==2.2.6

ENV LLVM_CONFIG=llvm-config-${LLVM_VERSION}
ENV AFL_SKIP_CPUFREQ=1
ENV AFL_TRY_AFFINITY=1
ENV AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1

WORKDIR /AFLplusplus
COPY afl/ .

ARG CC=gcc-$GCC_VERSION
ARG CXX=g++-$GCC_VERSION

RUN make clean && make source-only && make install
RUN command -v afl-fuzz && command -v afl-clang-fast && \
    python -c "import openai, PIL, numpy; print('openai', openai.__version__, 'pillow', PIL.__version__, 'numpy', numpy.__version__)"

# ---- Fuzz targets: /targets/<name>.{afl,cmp,asan} and /targets/seeds/<name>/ ----
# Pinned sources (commits or checksummed tarballs) so every teammate fuzzes the same binary.
# Libraries the TIFF and PNG targets link against are Ubuntu's builds, not instrumented: coverage is
# measured in libtiff/libpng only, but deflate- and JPEG-compressed images still decode.
RUN apt-get update && \
    apt-get install -y --no-install-recommends autoconf zlib1g-dev libjpeg-turbo8-dev && \
    rm -rf /var/lib/apt/lists/*
COPY targets/common /opt/g2f-targets/common
COPY targets/jhead /opt/g2f-targets/jhead
RUN bash /opt/g2f-targets/jhead/build.sh /targets
COPY targets/libtiff /opt/g2f-targets/libtiff
RUN bash /opt/g2f-targets/libtiff/build.sh /targets
COPY targets/libpng /opt/g2f-targets/libpng
RUN bash /opt/g2f-targets/libpng/build.sh /targets
COPY targets/libxml2 /opt/g2f-targets/libxml2
RUN bash /opt/g2f-targets/libxml2/build.sh /targets
COPY targets/doom /opt/g2f-targets/doom
RUN bash /opt/g2f-targets/doom/build.sh /targets

# ---- G2Fuzz's Python layer, last: it changes most often and rebuilds in seconds ----
COPY g2fuzz/ /AFLplusplus/g2fuzz/
RUN test -f /AFLplusplus/g2fuzz/generator_mutation.py && test -f /AFLplusplus/g2fuzz/program_gen.py && \
    test ! -e /AFLplusplus/g2fuzz/openai_key.txt

RUN echo "export PS1='[g2fuzz \h] \w \$ '" >> ~/.bashrc

WORKDIR /eval
