<?xml version="1.0" encoding="UTF-8"?>
<!-- This is a configuration file with XML Base specification compliance -->
<configuration xmlns:xml="http://www.w3.org/XML/1998/namespace" xml:base="http://example.com/configs/app/">
    <!-- Database settings with relative URI references -->
    <database>
        <host>localhost</host>
        <port>5432</port>
        <name>my_database</name>
        <!-- Relative URI resolves to http://example.com/configs/app/schemas/db.xsd -->
        <schemaLocation>./schemas/db.xsd</schemaLocation>
    </database>
    
    <!-- Application settings with xml:base for nested elements -->
    <application>
        <name>MyApplication</name>
        <version>1.0.0</version>
        <!-- Debug mode enabled for development -->
        <debug>true</debug>
        <!-- Relative URI resolves to http://example.com/configs/app/resources/logo.png -->
        <logo>resources/logo.png</logo>
    </application>
    
    <!-- External resources section with xml:base for relative URI resolution -->
    <resources xml:base="http://example.com/assets/">
        <stylesheet>css/styles.css</stylesheet>
        <javascript>js/app.js</javascript>
    </resources>
</configuration>
