<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="style.xsl"?>
<?mso-application progid="Excel.Sheet"?>
<?custom-processor version="2.1" mode="batch" target="backend"?>
<?custom-processor version="1.0" mode="realtime" target="frontend"?>
<document xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:xenc="http://www.w3.org/2001/04/xmlenc#" xmlns:dsig11="http://www.w3.org/2009/xmlenc11#" xmlns:c14n="http://www.w3.org/2006/12/XMLC14N11">
    <title>Processing Instructions, Signature, Encryption, and Canonicalization Example</title>
    <content>This XML document demonstrates processing instructions, digital signatures, encryption, and canonical XML variants.</content>
    <instruction>This processing instruction guides applications on how to process this document.</instruction>
    
    <!-- Processing instruction targeting and semantics examples -->
    <processing-instructions>
        <!-- Targeted instruction for XML processors -->
        <?xml-log level="debug" module="parser"?>
        <!-- Custom instruction for application-specific processing -->
        <?app-config timeout="30" retries="3" cache="enabled"?>
        <!-- Instruction for transformation engine -->
        <?transform-engine method="xslt" version="3.0" output="html"?>
        <!-- Instruction for validation engine -->
        <?validator schema="schema.xsd" mode="strict" errors="fatal"?>
    </processing-instructions>
    
    <!-- Digital Signature support with Canonicalization variants -->
    <security>
        <ds:Signature Id="Signature-1">
            <ds:SignedInfo>
                <!-- Canonicalization Method - Exclusive Canonical XML (ExclC14N) -->
                <ds:CanonicalizationMethod Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                <!-- Canonicalization Method - Inclusive Canonical XML (C14N) -->
                <ds:CanonicalizationMethod Algorithm="http://www.w3.org/TR/2001/REC-xml-c14n-20010315"/>
                <!-- Canonicalization Method - Canonical XML 1.1 (with comments) -->
                <ds:CanonicalizationMethod Algorithm="http://www.w3.org/2006/12/XMLC14N11#with-comments"/>
                <!-- Canonicalization Method - Exclusive Canonical XML 1.1 -->
                <ds:CanonicalizationMethod Algorithm="http://www.w3.org/2006/12/XMLC14N11#exclusive"/>
                
                <ds:SignatureMethod Algorithm="http://www.w3.org/2000/09/xmldsig#rsa-sha1"/>
                <ds:Reference URI="#content-1">
                    <ds:Transforms>
                        <ds:Transform Algorithm="http://www.w3.org/2000/09/xmldsig#enveloped-signature"/>
                        <ds:Transform Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                    </ds:Transforms>
                    <ds:DigestMethod Algorithm="http://www.w3.org/2000/09/xmldsig#sha1"/>
                    <ds:DigestValue>base64encodeddigestvalue=</ds:DigestValue>
                </ds:Reference>
            </ds:SignedInfo>
            <ds:SignatureValue>base64encodedsignature=</ds:SignatureValue>
            <ds:KeyInfo>
                <ds:X509Data>
                    <ds:X509Certificate>base64encodedcertificate=</ds:X509Certificate>
                </ds:X509Data>
            </ds:KeyInfo>
        </ds:Signature>
        
        <!-- XML Encryption (XMLEnc) support -->
        <xenc:EncryptedData Id="EncryptedData-1" Type="http://www.w3.org/2001/04/xmlenc#Content">
            <xenc:EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#aes128-cbc"/>
            <xenc:CipherData>
                <xenc:CipherValue>base64encryptedcontent=</xenc:CipherValue>
            </xenc:CipherData>
        </xenc:EncryptedData>
        
        <!-- Additional XMLEnc example: Encrypting a specific element -->
        <xenc:EncryptedKey Id="EncryptedKey-1">
            <xenc:EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p"/>
            <dsig11:DigestMethod Algorithm="http://www.w3.org/2000/09/xmldsig#sha1"/>
            <xenc:CipherData>
                <xenc:CipherValue>base64encryptedkey=</xenc:CipherValue>
            </xenc:CipherData>
        </xenc:EncryptedKey>
        
        <!-- Example of encrypted element content -->
        <xenc:EncryptedData Id="EncryptedData-2" Type="http://www.w3.org/2001/04/xmlenc#Element">
            <xenc:EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#tripledes-cbc"/>
            <xenc:CipherData>
                <xenc:CipherValue>base64encryptedelementcontent=</xenc:CipherValue>
            </xenc:CipherData>
        </xenc:EncryptedData>
        
        <!-- Canonicalization context demonstration for namespace isolation -->
        <c14n:CanonicalizationContext Id="context-1">
            <c14n:Method>exclusive</c14n:Method>
            <c14n:Description>Exclusive canonicalization for namespace context isolation in signed documents</c14n:Description>
            <c14n:InclusiveNamespaces PrefixList="ds xenc dsig11 c14n" xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
                                      xmlns:xenc="http://www.w3.org/2001/04/xmlenc#"
                                      xmlns:dsig11="http://www.w3.org/2009/xmlenc11#"
                                      xmlns:c14n="http://www.w3.org/2006/12/XMLC14N11"/>
            <c14n:Example>
                <!-- This element's namespace context is preserved during canonicalization -->
                <signedData xmlns:local="http://example.com/local">
                    <local:element>Content with namespace isolation</local:element>
                </signedData>
            </c14n:Example>
        </c14n:CanonicalizationContext>
    </security>
</document>
