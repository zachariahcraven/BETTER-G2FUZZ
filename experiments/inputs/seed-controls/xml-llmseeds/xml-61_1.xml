<?xml version="1.0" ?>
<invoice xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="invoice.xsd">
  <invoice_id>INV-2023-001</invoice_id>
  <date>2023-10-15</date>
  <customer>
    <customer_id>CUST-12345</customer_id>
    <customer_name>John Doe</customer_name>
  </customer>
  <xpath_examples>
    <xpath_example id="1">//items/item[@type=&quot;product&quot;]/item_name</xpath_example>
    <xpath_example id="2">//customer/customer_name</xpath_example>
    <xpath_example id="3">//item[quantity &gt; 1]/item_name</xpath_example>
  </xpath_examples>
  <rdf_serialization>
    <rdf_description about="http://example.org/invoice/INV-2023-001">
      <invoice_uri>http://example.org/invoice/INV-2023-001</invoice_uri>
      <invoice_date>2023-10-15</invoice_date>
      <invoice_customer>http://example.org/customer/CUST-12345</invoice_customer>
      <items>
        <item rdf:ID="item1">
          <item_type>product</item_type>
          <item_name>Wireless Mouse</item_name>
          <item_quantity>2</item_quantity>
          <item_price>25.99</item_price>
        </item>
        <item rdf:ID="item2">
          <item_type>service</item_type>
          <item_name>Installation Service</item_name>
          <item_quantity>1</item_quantity>
          <item_price>50.00</item_price>
        </item>
      </items>
    </rdf_description>
  </rdf_serialization>
  <items>
    <item type="product">
      <item_id>PROD-001</item_id>
      <item_name>Wireless Mouse</item_name>
      <quantity>2</quantity>
      <price>25.99</price>
    </item>
    <item type="service">
      <item_id>SRV-002</item_id>
      <item_name>Installation Service</item_name>
      <quantity>1</quantity>
      <price>50.00</price>
    </item>
  </items>
</invoice>
