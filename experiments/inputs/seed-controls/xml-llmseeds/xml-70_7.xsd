<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <!-- Root element -->
  <xs:element name="ns_demo">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="global_scope">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="description" type="xs:string"/>
              <xs:element name="namespace" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="prefix" type="xs:string" use="required"/>
                  <xs:attribute name="uri" type="xs:anyURI" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="scope" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="scope_desc" type="xs:string"/>
              <xs:element name="example" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="nested_scope">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="scope_desc" type="xs:string"/>
              <xs:element name="namespace" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="prefix" type="xs:string" use="required"/>
                  <xs:attribute name="uri" type="xs:anyURI" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="example" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="xml:lang" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
</xs:schema>