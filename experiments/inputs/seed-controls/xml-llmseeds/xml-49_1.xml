<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="style.xsl"?>
<?mso-application progid="Excel.Sheet"?>
<?custom-processor version="2.1" mode="batch" target="backend"?>
<?custom-processor version="1.0" mode="realtime" target="frontend"?>
<document xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:xenc="http://www.w3.org/2001/04/xmlenc#" xmlns:dsig11="http://www.w3.org/2009/xmlenc11#" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <title>Processing Instructions, Signature, Encryption, and Mixed Content Example</title>
    <content>This XML document demonstrates processing instructions, digital signatures, encryption, and mixed content with character data significance.</content>
    <instruction>This processing instruction guides applications on how to process this document.</instruction>
    
    <!-- Processing instruction targeting and semantics examples -->
    <processing-instructions>
        <!-- Targeted instruction for XML processors -->
        <?xml-log level="debug" module="parser"?>
        <!-- Custom instruction for application-specific processing -->
        <?app-config timeout="30" retries="3" cache="enabled"?>
        <!-- Instruction for transformation engine -->
        <?transform-engine method="xslt" version="3.0" output="html"?>
        <!-- Instruction for validation engine -->
        <?validator schema="schema.xsd" mode="strict" errors="fatal"?>
    </processing-instructions>
    
    <!-- Digital Signature support -->
    <security>
        <ds:Signature Id="Signature-1">
            <ds:SignedInfo>
                <ds:CanonicalizationMethod Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                <ds:SignatureMethod Algorithm="http://www.w3.org/2000/09/xmldsig#rsa-sha1"/>
                <ds:Reference URI="#content-1">
                    <ds:Transforms>
                        <ds:Transform Algorithm="http://www.w3.org/2000/09/xmldsig#enveloped-signature"/>
                        <ds:Transform Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                    </ds:Transforms>
                    <ds:DigestMethod Algorithm="http://www.w3.org/2000/09/xmldsig#sha1"/>
                    <ds:DigestValue>base64encodeddigestvalue=</ds:DigestValue>
                </ds:Reference>
            </ds:SignedInfo>
            <ds:SignatureValue>base64encodedsignature=</ds:SignatureValue>
            <ds:KeyInfo>
                <ds:X509Data>
                    <ds:X509Certificate>base64encodedcertificate=</ds:X509Certificate>
                </ds:X509Data>
            </ds:KeyInfo>
        </ds:Signature>
        
        <!-- XML Encryption (XMLEnc) support -->
        <xenc:EncryptedData Id="EncryptedData-1" Type="http://www.w3.org/2001/04/xmlenc#Content">
            <xenc:EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#aes128-cbc"/>
            <xenc:CipherData>
                <xenc:CipherValue>base64encryptedcontent=</xenc:CipherValue>
            </xenc:CipherData>
        </xenc:EncryptedData>
        
        <!-- Additional XMLEnc example: Encrypting a specific element -->
        <xenc:EncryptedKey Id="EncryptedKey-1">
            <xenc:EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p"/>
            <dsig11:DigestMethod Algorithm="http://www.w3.org/2000/09/xmldsig#sha1"/>
            <xenc:CipherData>
                <xenc:CipherValue>base64encryptedkey=</xenc:CipherValue>
            </xenc:CipherData>
        </xenc:EncryptedKey>
        
        <!-- Example of encrypted element content -->
        <xenc:EncryptedData Id="EncryptedData-2" Type="http://www.w3.org/2001/04/xmlenc#Element">
            <xenc:EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#tripledes-cbc"/>
            <xenc:CipherData>
                <xenc:CipherValue>base64encryptedelementcontent=</xenc:CipherValue>
            </xenc:CipherData>
        </xenc:EncryptedData>
    </security>
    
    <!-- Mixed content with character data significance semantics -->
    <mixed-content-example xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xsi:schemaLocation="http://example.com/mixed mixed-content.xsd">
        <!-- Example of mixed content where text and elements are interleaved with preserved whitespace -->
        <paragraph>
            This paragraph contains mixed content with character data significance. 
            <emphasis>Important terms</emphasis> should be preserved with their surrounding whitespace, 
            and <strong>formatted sections</strong> must maintain spacing semantics 
            for proper rendering and processing.
        </paragraph>
        
        <!-- Another example showing more complex mixed content -->
        <formatted-text>
            The <cmd>ls -l</cmd> command lists files in long format, 
            while <cmd>chmod +x script.sh</cmd> makes the script executable. 
            Always verify <path>/usr/local/bin</path> is in your <env>PATH</env>.
        </formatted-text>
        
        <!-- Mixed content with significant whitespace for preformatted text -->
        <preformatted>
            function example() {
                console.log("Hello, World!");
                return true;
            }
        </preformatted>
        
        <!-- Mixed content with inline markup and preserved whitespace -->
        <documentation>
            Use the <code>parseXML()</code> function to parse XML documents. 
            It supports <feature> namespaces </feature> and 
            <feature> validation </feature> by default.
        </documentation>
        
        <!-- Mixed content with significant whitespace for mathematical expressions -->
        <math-expression>
            The quadratic formula is <math>x = (-b ± √(b² - 4ac)) / (2a)</math>, 
            where <var>a</var> ≠ 0.
        </math-expression>
    </mixed-content-example>
</document>
